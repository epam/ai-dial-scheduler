          ],
          "maxRetryAttempts": 1,
          "order": 2147483647,
          "permissions": [
            "READ"
          ],
          "attachmentPaths": {
            "requestBody": [],
            "responseBody": []
          }
        }
      },
      "folderId": "public/",
      "path": "public/dial_scheduler__1.0.0",
      "version": "1.0.0",
      "id": "applications/public/dial_scheduler__1.0.0"
    }
  ]
