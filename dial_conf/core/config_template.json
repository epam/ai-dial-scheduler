{
  "applications": {
    "scheduler": {
      "endpoint": "http://scheduler",
      "displayName": "DIAL Scheduler",
      "routes": {
        "main": {
          "dial:rewritePath": true,
          "dial:paths": [
            "/.*"
          ],
          "dial:methods": [
            "DELETE",
            "GET",
            "PATCH",
            "POST",
            "PUT"
          ],
          "dial:upstreams": [
            {
              "dial:endpoint": "http://host.docker.internal:5000",
              "dial:weight": 1,
              "dial:tier": 0
            }
          ],
          "dial:maxRetryAttempts": 1,
          "dial:order": 2147483647,
          "dial:permissions": [
            "READ",
            "WRITE"
          ],
          "dial:attachmentPaths": {
            "dial:requestBody": [],
            "dial:responseBody": []
          }
        }
      }
    }
  },
  "models": {
    "gpt-4.1-mini-2025-04-14": {
      "type": "chat",
      "name": "gpt-4.1-mini-2025-04-14",
      "endpoint": "http://adapter-dial:5000/openai/deployments/gpt-4.1-mini-2025-04-14/chat/completions",
      "displayName": "gpt-4.1-mini-2025-04-14",
      "forwardAuthToken": false,
      "description_keywords": [
        "OCR Extraction"
      ],
      "inputAttachmentTypes": [
        "*/*"
      ],
      "maxInputAttachments": 5,
      "maxRetryAttempts": 3,
      "upstreams": [
        {
          "endpoint": "<DIAL_URL>/openai/deployments/gpt-4.1-mini-2025-04-14/chat/completions",
          "key": "<DIAL_API_KEY>"
        }
      ]
    }
  },
  "keys": {
    "dial_api_key": {
      "key": "dial_api_key",
      "project": "TEST-PROJECT",
      "secured": false,
      "roles": [
        "default"
      ]
    }
  },
  "roles": {
    "default": {
      "name": "default",
      "limits": {
      }
    }
  }
}
