# Copy to .env and fill in real values before running docker compose up

DIAL_URL=https://dial.example.com
DIAL_API_KEY=changeme # same api that added as app identity to scheduler app

DB_HOST=postgres
DB_PORT=5432
DB_NAME=scheduler
DB_USER=scheduler
DB_PASSWORD=changeme
DB_AUTH_MODE=password

# Workload-identity auth modes (no DB_PASSWORD / DB_URL may be set with these).
# AWS RDS / Aurora PostgreSQL IAM database authentication:
# DB_AUTH_MODE=aws_iam
# DB_AWS_IAM_USER=scheduler_iam
# DB_AWS_REGION=eu-central-1  # optional; falls back to AWS_REGION / AWS_DEFAULT_REGION

# Optional: run `alembic upgrade head` before the api/worker starts (off by default).
# RUN_MIGRATIONS_ON_START=false

LOG_LEVEL=INFO
PORT=5000
ENV=dev
APP_NAME=aidial-scheduler

# Readiness probe
# READINESS_DB_TIMEOUT_SECONDS=2.0

# Observability / OpenTelemetry (OTLP export)
# Uncomment and set OTEL_EXPORTER_OTLP_ENDPOINT to send traces and metrics to a collector.
# When none of the OTEL_*_EXPORTER vars are set, telemetry export is a no-op (safe default).
#
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=aidial-scheduler
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_PROMETHEUS_PORT=9464
# OTEL_LOG_LEVEL=ERROR
