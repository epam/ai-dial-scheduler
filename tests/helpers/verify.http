  "display_name": "Minimal cron",
  "trigger": {
    "cron": {
      "fields": {}
    }
  },
  "properties": {
    "target_type": "chat_completion",
    "url": "https://core.dial/openai/deployments/gpt-4o/chat/completions"
  }
}


