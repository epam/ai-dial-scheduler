###

### Update schedule — change display_name and trigger
PUT {{baseUrl}}/v1/schedules/{{scheduleId}}
Content-Type: application/json

{
  "display_name": "Daily GPT report",
  "trigger": {
    "cron": {
      "fields": {
        "minute": "*"
      }
    }
  },
  "properties": {
    "target_type": "chat_completion",
    "url": "https://core.dial/openai/deployments/gpt-4o/chat/completions",
    "payload": {
      "messages": [{"role": "user", "content": "Generate daily report"}]
    },
    "extra_headers": {"tenant_id": "acme"},
    "api_version": "2024-02-99"
  }
}

###

### Update schedule — switch from cron to date trigger
PUT {{baseUrl}}/v1/schedules/{{scheduleId}}
Content-Type: application/json

{
  "display_name": "One-time migration job",
  "trigger": {
    "date": "2030-06-01T06:00:00+00:00"
  },
  "properties": {
    "target_type": "rest",
    "method": "POST",
    "url": "https://api.example.com/migrate",
    "payload": {"version": "v2"}
  }
}


