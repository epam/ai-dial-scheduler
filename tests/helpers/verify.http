### Variables
# Switch between direct and DIAL-routed access by toggling the active @baseUrl line.
#@baseUrl = http://localhost:5000
@baseUrl = http://127.0.0.1:8081/v1/deployments/dial_scheduler/route

@dialUrl = http://127.0.0.1:8081

# Auth — credential value is centralised here; header name is fixed as Api-Key.
# To switch to Bearer: find-replace  "Api-Key: {{authValue}}"
#                               with  "Authorization: Bearer {{authValue}}"
@authValue = "dial-chat-token"

# service_id is required on every create/update body. It selects the external service
# (registered in application/external-services) whose per-user on-behalf-of credentials
# authenticate the schedule's execution — "dial-native" (DIAL_NATIVE offline delegation).
# The requesting user must have connected offline credentials (see scripts/dial_sign_in.py),
# and an admin must have approved this app, or the run fails with a credentials-stage error.

# Paste the id returned by a Create request before running Update / Detail requests.
@scheduleId = bb16ca12-1cff-4c1c-bd36-83c02d41ef19
# Paste the id returned by a run in the list response before running Run Detail requests.
@runId = 6239576f-44e6-4ef7-951a-4832d6e2f31c


### ============================================================
### CREATE
### ============================================================

# @name create_real_dial_streaming_job_oauth_service
### Streaming chat_completion against real DIAL gpt-4.1-mini (fires every 30 s)
POST {{baseUrl}}/v1/schedules/
Content-Type: application/json
Authorization: Bearer {{authValue}}

{
  "display_name": "Real DIAL streaming smoke test",
  "service_id": "dial-native",
  "trigger": {
    "cron": {"fields": {"second": "*/30"}}
  },
  "properties": {
    "target_type": "chat_completion",
    "url": "{{dialUrl}}/openai/",
    "payload": {
      "messages": [{"role": "user", "content": "hello, how are you?"}],
      "model": "gpt-4.1-mini-2025-04-14",
      "stream": true
    },
    "api_version": "2025-01-01-preview"
  }
}

###
