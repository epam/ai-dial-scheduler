### Variables
@baseUrl = http://localhost:5000
@dialUrl = http://127.0.0.1:8080
// Paste the id returned by any Create request before running Update / Detail requests.
@scheduleId = 1260c271-9804-42c0-8521-fd469683ae44
// Paste the id returned by any run in the list response before running Run Detail requests.
@runId = 6239576f-44e6-4ef7-951a-4832d6e2f31c


### ============================================================
### CREATE — happy paths
### ============================================================

# @name create_cron
### Create schedule with cron trigger (chat_completion)
POST {{baseUrl}}/v1/schedules/
Content-Type: application/json

{
  "display_name": "Daily GPT report",
  "trigger": {
    "cron": {
      "fields": {
        "hour": "9",
        "minute": "0",
        "day_of_week": "mon-fri"
      }
    }
  },
  "properties": {
    "target_type": "chat_completion",
    "url": "https://core.dial/openai/deployments/gpt-4o/chat/completions",
    "payload": {
      "messages": [{"role": "user", "content": "Generate daily report"}]
    },
    "extra_headers": {"tenant_id": "acme"},
    "api_version": "2024-02-01"
  }
}

###


# @name create_cron_every_second
### Create schedule with cron trigger (chat_completion)
POST {{baseUrl}}/v1/schedules/
Content-Type: application/json

{
  "display_name": "Daily GPT report",
  "trigger": {
    "cron": {
      "fields": {
        "second": "*"
      }
    }
  },
  "properties": {
    "target_type": "chat_completion",
    "url": "https://core.dial/openai/deployments/gpt-4o/chat/completions",
    "payload": {
      "messages": [{"role": "user", "content": "Generate daily report"}]
    },
    "extra_headers": {"tenant_id": "acme"},
    "api_version": "2024-02-01"
  }
}

###

# @name create_cron_with_date_bounds
### Create cron schedule with start/end bounds
POST {{baseUrl}}/v1/schedules/
Content-Type: application/json

{
  "display_name": "Bounded cron",
  "trigger": {
    "cron": {
      "fields": {"hour": "10", "minute": "30"},
      "start_date": "2026-07-01T00:00:00+00:00",
      "end_date": "2026-12-31T23:59:59+00:00"
    }
  },
  "properties": {
    "target_type": "chat_completion",
    "url": "https://core.dial/openai/deployments/gpt-4o/chat/completions",
    "payload": {"messages": [{"role": "user", "content": "hello"}], "stream": true}
  }
}

###

# @name create_date
### Create schedule with one-shot date trigger
POST {{baseUrl}}/v1/schedules/
Content-Type: application/json

{
  "display_name": "One-shot job",
  "trigger": {
    "date": "2030-01-15T09:00:00+00:00"
  },
  "properties": {
    "target_type": "rest",
    "method": "POST",
    "url": "https://api.example.com/webhook",
    "payload": {"event": "trigger"},
    "extra_headers": {"X-Source": "scheduler"}
  }
}

###

# @name create_rest_get
### Create REST schedule with GET method
POST {{baseUrl}}/v1/schedules/
Content-Type: application/json

{
  "display_name": "Hourly health check",
  "trigger": {
    "cron": {
      "fields": {"minute": "0"}
    }
  },
  "properties": {
    "target_type": "rest",
    "method": "GET",
    "url": "https://api.example.com/health"
  }
}

###

# @name create_sse
### Create SSE schedule
POST {{baseUrl}}/v1/schedules/
Content-Type: application/json

{
  "display_name": "Streaming alert",
  "trigger": {
    "cron": {
      "fields": {"hour": "8", "minute": "0"}
    }
  },
  "properties": {
    "target_type": "sse",
    "method": "POST",
    "url": "https://api.example.com/stream",
